PORT=4000

# Set to false once you have real Razorpay test-mode keys and want to hit
# the actual UPI Autopay endpoints instead of the built-in simulator.
RAZORPAY_MOCK=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Used when live mode registers a customer/charges them, if you don't pass
# name/email/contact in the policy request body from the frontend.
DEMO_CUSTOMER_NAME=Demo User
DEMO_CUSTOMER_EMAIL=demo@example.com
DEMO_CUSTOMER_CONTACT=9876543210

# Used to sign every mandate (HMAC-SHA256). Change this in any real deployment.
MANDATE_SECRET=change-me-in-production

# How long the demo waits before "executing" a scheduled debit, in ms.
# In production this stands in for the real 24-hour RBI pre-debit notice window.
DEMO_DEBIT_DELAY_MS=8000
